diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 2802103..7abd46c 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -1823,6 +1823,74 @@ size_t llama_kv_cache::size_v_bytes() const {
     return size_v_bytes;
 }
 
+bool llama_kv_cache::view(
+        llama_seq_id seq_id,
+        llama_memory_kv_cache_cell * cells,
+        size_t cells_capacity,
+        size_t * cells_count,
+        llama_memory_kv_cache_stats * stats) const {
+    if (!cells_count || !stats || stats->struct_size != sizeof(*stats) ||
+        seq_id < -1 || (seq_id >= 0 && (size_t) seq_id >= seq_to_stream.size()) ||
+        (!cells && cells_capacity != 0)) {
+        return false;
+    }
+
+    uint32_t capacity = 0;
+    uint32_t used = 0;
+    uint32_t shared = 0;
+    uint32_t sequence = 0;
+    size_t matches = 0;
+    for (uint32_t stream = 0; stream < v_cells.size(); ++stream) {
+        const auto & stream_cells = v_cells[stream];
+        capacity += stream_cells.size();
+        for (uint32_t cell = 0; cell < stream_cells.size(); ++cell) {
+            if (stream_cells.is_empty(cell)) {
+                continue;
+            }
+            ++used;
+            const uint32_t sequence_count = stream_cells.seq_count(cell);
+            if (sequence_count > 1) {
+                ++shared;
+            }
+            const bool selected = seq_id < 0 || stream_cells.seq_has(cell, seq_id);
+            if (!selected) {
+                continue;
+            }
+            ++sequence;
+            if (cells && matches < cells_capacity) {
+                cells[matches] = {
+                    stream,
+                    cell,
+                    stream_cells.pos_get(cell),
+                    sequence_count,
+                };
+            }
+            ++matches;
+        }
+    }
+
+    const uint64_t payload = size_k_bytes() + size_v_bytes();
+    if (capacity == 0 || payload % capacity != 0) {
+        return false;
+    }
+    const uint64_t bytes_per_cell = payload / capacity;
+    *stats = {
+        sizeof(*stats),
+        total_size(),
+        payload,
+        bytes_per_cell * used,
+        bytes_per_cell * shared,
+        bytes_per_cell * sequence,
+        capacity,
+        used,
+        shared,
+        sequence,
+        (uint32_t) v_cells.size(),
+    };
+    *cells_count = matches;
+    return !cells || cells_capacity >= matches;
+}
